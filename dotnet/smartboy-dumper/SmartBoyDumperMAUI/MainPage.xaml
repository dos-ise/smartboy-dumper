<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartBoyDumperMAUI.MainPage"
             BackgroundColor="#F4F5F8">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#3A6FF7</Color>
            <Color x:Key="TextPrimary">#1A1D29</Color>
            <Color x:Key="TextSecondary">#6B7080</Color>
            <Color x:Key="CardBackground">#FFFFFF</Color>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
                <Setter Property="Stroke" Value="Transparent" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="Black" Opacity="0.08" Radius="12" Offset="0,3" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HeightRequest" Value="52" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Kein ScrollView mehr - alles muss ohne Scrollen in den oberen
         sichtbaren Bereich passen, da der Adapter unten am Gerät hängt
         und die untere Bildschirmhälfte physisch verdeckt. -->
    <VerticalStackLayout Padding="20,16" Spacing="12" VerticalOptions="Start">

        <Label Text="GB Cartridge Dumper"
               FontSize="20" FontAttributes="Bold"
               TextColor="{StaticResource TextPrimary}" />

        <!-- Status-Karte: kompakt, alles Wichtige auf einen Blick -->
        <Border Style="{StaticResource CardStyle}">
            <VerticalStackLayout Spacing="10">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Grid.Column="0" WidthRequest="46" HeightRequest="46"
                            StrokeShape="RoundRectangle 12" Stroke="Transparent"
                            BackgroundColor="#EEF1F8">
                        <Label x:Name="StatusIcon" Text="🎮" FontSize="22"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label x:Name="StatusTitle" Text="Bereit" FontSize="16"
                               FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label x:Name="StatusSubtitle" Text="Adapter anschließen und starten."
                               FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout x:Name="ProgressSection" Spacing="4" IsVisible="False">
                    <ProgressBar x:Name="DumpProgressBar" Progress="0"
                                 ProgressColor="{StaticResource PrimaryColor}" HeightRequest="7" />
                    <Label x:Name="ProgressLabel" Text="0%" FontSize="11"
                           TextColor="{StaticResource TextSecondary}" HorizontalOptions="End" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="ResultSection" Spacing="8" IsVisible="False">
                    <BoxView HeightRequest="1" BackgroundColor="#EEF0F5" />
                    <Label x:Name="ResultPathLabel" FontSize="11"
                           TextColor="{StaticResource TextSecondary}"
                           LineBreakMode="MiddleTruncation" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <Button x:Name="ActionButton" Text="Dump starten"
                Style="{StaticResource PrimaryButtonStyle}"
                Clicked="ActionButton_Clicked" />

        <Border x:Name="ErrorCard" Style="{StaticResource CardStyle}"
                IsVisible="False" BackgroundColor="#FDEEEE" Padding="12">
            <Label x:Name="ErrorLabel" TextColor="#E5484D" FontSize="13"
                   LineBreakMode="WordWrap" />
        </Border>

        <!-- Temporär für Diagnose ohne Kabel - später entfernen -->
        <Button Text="Letzten Fehler anzeigen" FontSize="12" HeightRequest="36"
                BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                Clicked="ShowLastCrash_Clicked" />

    </VerticalStackLayout>

</ContentPage>